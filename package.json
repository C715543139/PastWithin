{
  "name": "past-within",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "manifest": {
    "name": "PastWithin",
    "description": "本地优先的 Chrome 历史和书签正文搜索工具",
    "permissions": [
      "storage",
      "bookmarks",
      "tabs"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ]
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.0",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "plasmo": "^0.90.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
